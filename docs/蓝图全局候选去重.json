{
  "schemaVersion": "blueprint-global-candidate-deduplication/v1",
  "implementedAt": "2026-11-15",
  "scope": "单次Generate内，普通/超密度四种公开运输模式的有效计划归一化，以及所有模式和重试阶段共用的成功终检缓存。",
  "rules": [
    "普通直连只去掉不参与执行的方向/密铺参数，保留两种真实原料入口及有效排版。",
    "配送按实际局部模块边界测量尺度预算，执行与装配相同的最小限制、取整、纬带限高后去重；排序、容量预留、地面轨、纬向预算和材料顺序仍分开。独立探针在模块装配后退出，不进入全场占位或发布预览；测量失败保留原候选。黑盒街道仍保守保留。",
    "塔候选先剥离确定无效的共享出口、双侧输出、分流修饰，再按装配实际消费的完整几何和上下文参数稳定保留首项。共享出口无法合流原本是错误，此处剥离修饰后仍重新完整生成，不缓存该失败。",
    "相同最终建筑记录及顺序、连接/槽位/物料参数、请求、Area、球面锚点、坐标系、校验状态、密铺碰撞开关经SHA-256标识后，可复用已成功的纯终检；依赖builder身份的机器、物流、流量和缓存链检查照常执行。",
    "缓存每请求独立，最多128项；同键并发合并，失败与超时不缓存，等待者取消不影响执行者，容量满时独立执行并保持相同取消语义；返回审计复制切片，正确重放检查标记。",
    "候选预览在过滤后按实际派发数量创建；获选图仍独立编码、严格解码、生成绑定与预览结果。"
  ],
  "interface": {
    "resultPath": "result.candidateDeduplication",
    "performancePath": "performance.candidateDeduplication（包括失败请求的WithPerformance观察回调）",
    "frontendType": "candidates.Report（Wails自动生成）",
    "fields": {
      "stages": "按scope稳定排序的阶段累计，各阶段含scope/proposed/unique/skipped/inactiveModifiers。",
      "proposed": "已登记规划阶段的原候选数之和，包括嵌套重试；不是唯一整厂蓝图数。",
      "unique": "各阶段归一后保留候选数之和；是可派发上限，早停时可能未全部执行，也不保证不同键一定生成不同实体。",
      "skipped": "proposed-unique，规划前实际省掉的候选数，不包含终检复用。",
      "inactiveModifiers": "剥离的无效策略修饰数量，可大于skipped，不是建筑数。",
      "finalRules.requested": "最终规则缓存入口调用数，包括取消。",
      "finalRules.executed": "真实完整终检工作次数，包括失败；不包含先前装配、寻路、货物校正等工作。",
      "finalRules.reused": "相同状态成功终检的复用次数，包括等待相同并发工作。",
      "finalRules.uncached": "容量已满后独立执行次数，是executed的子集。"
    }
  },
  "verification": {
    "unitAndRegression": "go test ./helper/blueprint/build/... -count=1 -timeout 10m 通过；新增的候选规则针对性测试和缓存满时取消测试通过。",
    "builds": [
      "wails generate module 通过",
      "npm run build 通过",
      "go build ./... 通过"
    ],
    "raceDetector": "当前环境CGO关闭，未运行竞态检测；执行了并发成功复用、失败重试和取消测试。",
