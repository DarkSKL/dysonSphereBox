  "cards": [
    {
      "dot": "cyan",
      "title": "两条线的真实节奏",
      "items": [
        "所有事件都走 Wails 事件 factory:generationProgress",
        "后端在 Generate 返回前就已发完整条流，时间轴中段就是它的终点",
        "前端全量缓存，再把获选候选按 100ms 一条重放，视觉时长由前端决定"
      ]
    },
    {
      "dot": "amber",
      "title": "三道闸门",
      "items": [
        "beginPreview 必须先行：先清场，到达的差量才不会被旧场景吞掉",
        "replayingDeltas 拦住 commitPreview，完整蓝图只能在动画播完后落下",
        "skipNextCodeReload 拦住 code 变化触发的全量重载，避免闪白"
      ]
    },
    {
      "dot": "rose",
      "title": "失败与中断",
      "items": [
        "search-failed → reset()；stream-incomplete → discarded++ 后 reset()",
        "生成失败 → discardPreview() 用快照恢复上一次成功画面",
        "GEN_E_PROGRESS_PREVIEW → 先丢弃过程预览，再以 v3 无差量重试一次"
      ]
    }
  ]
